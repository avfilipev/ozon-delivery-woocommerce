<?xml version="1.0"?>
<ruleset name="Ozon Delivery for WooCommerce">
    <description>WordPress Coding Standards для плагина Ozon Delivery.</description>

    <file>src</file>
    <file>tests</file>
    <file>uninstall.php</file>
    <file>ozon-delivery-for-woocommerce.php</file>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_supported_wp_version" value="6.4"/>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra">
        <!-- Классы автозагружаются по PSR-4, файлы не переименовывать под class-*.php. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- PSR-4 требует строгое соответствие "1 файл — 1 класс/интерфейс". -->
        <exclude name="Generic.Files.OneObjectStructurePerFile"/>
        <!--
            Сообщения исключений уходят в журнал WooCommerce, а не в браузер.
            Экранирование делается в точке вывода (admin_notices — через esc_html),
            иначе в логах окажутся HTML-сущности вместо читаемого текста.
        -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ozon-delivery-for-woocommerce"/>
            </property>
        </properties>
    </rule>

    <!--
        Подмена $wpdb — штатный приём юнит-теста без базы. В боевом коде
        правило продолжает действовать.
    -->
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!--
        В юнит-тестах нет файловой системы WordPress: временные файлы
        создаются обычными функциями PHP. В боевом коде правило действует.
    -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!--
        Сигнатуру команд диктует WP-CLI: он всегда передаёт и позиционные,
        и именованные аргументы, даже когда команда их не использует.
    -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <exclude-pattern>src/Cli/*</exclude-pattern>
    </rule>

    <!-- Капабилити WooCommerce: ядру WordPress они неизвестны. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
