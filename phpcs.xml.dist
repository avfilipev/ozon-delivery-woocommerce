<?xml version="1.0"?>
<ruleset name="Ozon Delivery for WooCommerce">
    <description>WordPress Coding Standards для плагина Ozon Delivery.</description>

    <file>src</file>
    <file>tests</file>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_supported_wp_version" value="6.4"/>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra">
        <!-- Классы автозагружаются по PSR-4, файлы не переименовывать под class-*.php. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- PSR-4 требует строгое соответствие "1 файл — 1 класс/интерфейс". -->
        <exclude name="Generic.Files.OneObjectStructurePerFile"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ozon-delivery-for-woocommerce"/>
            </property>
        </properties>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
