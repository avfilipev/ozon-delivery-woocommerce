# Ключи частного приложения Ozon Доставки.
#
# Скопируйте в .env.local (он в .gitignore) и заполните.
#
# ВАЖНО: сам плагин эти переменные НЕ читает. Секреты живут в опциях
# WordPress и задаются на экране WooCommerce → Настройки → Ozon Доставка.
# Этот файл — только памятка о том, что нужно получить, и удобство для
# локальной разработки.
#
# Где взять: личный кабинет Ozon Доставки → Настройки → Управление частными
# приложениями → Создать.

OZON_CLIENT_ID=
OZON_CLIENT_SECRET=

# Один из: delivery-api.delivery, delivery-api.delivery-point,
# delivery-api.order, delivery-api.posting, delivery-api.return,
# delivery-api.all
OZON_SCOPE=delivery-api.all

# Номер штрихкода метода доставки из раздела «Методы доставки» кабинета.
OZON_SHIPMENT_METHOD_ID=
